
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local StarterGui = game:GetService("StarterGui")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

-- Configuration for fruits that should not be displayed
local DontShow = {
    "Fruit1",
"Blox Fruit Dealer",
"Blox Fruit Gacha"

}

-- Checks whether an object should be detected as a fruit
-- The object must be a Tool or Model
-- The name must contain "fruit"
-- The object must not be listed in DontShow
local function isFruit(object)
    -- Ignore objects that are not Tools or Models
    if not (object:IsA("Tool") or object:IsA("Model")) then
        return false
    end

    -- Ignore fruits listed in the DontShow table
    if table.find(DontShow, object.Name) then
        return false
    end

    -- Check if the object's name contains "fruit"
    return string.find(object.Name:lower(), "fruit") ~= nil
end

-- Sends a Roblox-style notification when a new fruit is detected
-- Shows the fruit name and its distance from the player
local function notifyFruit(fruit, part)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")

    if not rootPart then
        return
    end

    -- Calculate the distance between the player and the fruit
    local distance = (rootPart.Position - part.Position).Magnitude
    distance = math.floor(distance)

    -- Send the notification
    StarterGui:SetCore("SendNotification", {
        Title = "New fruit detected",
        Text = "Name: " .. fruit.Name .. "\nDistance: " .. distance .. " studs",
        Duration = 5
    })
end

-- Creates the ESP display for a detected fruit
-- Prevents duplicate ESP objects
-- Attaches the ESP to the fruit's BasePart
local function createESP(fruit)
    -- Prevent duplicate ESPs
    if fruit:FindFirstChild("FruitESP") then
        return
    end

    -- Find a BasePart inside the fruit
    local part = fruit:FindFirstChildWhichIsA("BasePart", true)

    -- Stop if the fruit does not have a BasePart yet
    if not part then
        return
    end

    -- Create the BillboardGui used for the ESP
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "FruitESP"
    billboard.AlwaysOnTop = true
    billboard.Size = UDim2.new(0, 150, 0, 35)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = part

    -- Create the text label displayed above the fruit
    local label = Instance.new("TextLabel")
    label.Parent = billboard
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "🍎 " .. fruit.Name
    label.TextColor3 = Color3.fromRGB(0, 255, 127)
    label.TextScaled = true
    label.Font = Enum.Font.SourceSansBold
    label.TextStrokeTransparency = 0.5

    -- Display the ESP through CoreGui
    billboard.Parent = CoreGui

    -- Show notification for the newly detected fruit
    notifyFruit(fruit, part)
end

-- Prepares a fruit for ESP creation
-- Waits for the fruit's BasePart to load
local function setupFruit(fruit)
    -- Ignore objects that are not fruits
    if not isFruit(fruit) then
        return
    end

    -- Run the loading process separately
    task.spawn(function()
        -- Check for the BasePart up to 20 times
        for _ = 1, 20 do
            -- Stop if the fruit no longer exists
            if not fruit.Parent then
                return
            end

            -- Create the ESP once the BasePart is available
            if fruit:FindFirstChildWhichIsA("BasePart", true) then
                createESP(fruit)
                print("Fruit detected:", fruit.Name)
                return
            end

            -- Wait briefly before checking again
            task.wait(0.1)
        end
    end)
end

-- Scan all existing objects inside Workspace
-- GetDescendants detects fruits inside folders and models too
for _, object in ipairs(Workspace:GetDescendants()) do
    setupFruit(object)
end

-- Detect new objects added anywhere inside Workspace
-- Newly spawned fruits will automatically receive ESP and a notification
Workspace.DescendantAdded:Connect(function(object)
    setupFruit(object)
end)

-- Remove the ESP when an object is removed
-- This prevents old ESP markers from staying behind
Workspace.DescendantRemoving:Connect(function(object)
    local esp = object:FindFirstChild("FruitESP")

    if esp then
        esp:Destroy()
    end
end)
